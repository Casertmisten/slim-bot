# 后端配置（复制为 .env 并填写真实值）
# 访问令牌（前端 Bearer Token 必须与此一致）
APP_TOKEN=change-me-please

# 数据库路径
DATABASE_URL=sqlite+aiosqlite:///./data/coach.db

# OpenAI 兼容 LLM 配置
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# RAG（MVP 留空 = 关闭）
RAG_ENABLED=false

# 上传目录
UPLOAD_DIR=./uploads
